#include <winuser.h>
#include "version.h"
1 ICON "skyline.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "skyline.manifest"
1 VERSIONINFO
FILEVERSION SKYLINE_VERSION_MAJOR,SKYLINE_VERSION_MINOR,SKYLINE_VERSION_PATCH,0
PRODUCTVERSION SKYLINE_VERSION_MAJOR,SKYLINE_VERSION_MINOR,SKYLINE_VERSION_PATCH,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Yen-Zen & Cyber"
      VALUE "FileDescription", "Skyline"
      VALUE "ProductName", "Skyline"
      VALUE "FileVersion", SKYLINE_VERSION_STR
      VALUE "ProductVersion", SKYLINE_VERSION_STR
      VALUE "LegalCopyright", "Copyright (C) 2026 Yen-Zen & Cyber. All rights reserved."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
